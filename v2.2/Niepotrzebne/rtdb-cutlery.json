{
  "rooms": {
    "$code": {
      ".read": "auth != null && $code.matches(/^[A-Z]{4}$/)",
      ".write": "auth != null && $code.matches(/^[A-Z]{4}$/)",
      "meta": {
        "ch": {
          ".validate": "(newData.isNumber() && newData.val() >= 1 && newData.val() <= 3) || (newData.isString() && newData.val().matches(/^[bdt][1-3]$/))"
        },
        "host": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        }
      },
      "players": {
        "$uid": {
          "nick": {
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "char": {
            ".validate": "newData.val() == '' || newData.val() == 'fork' || newData.val() == 'knife' || newData.val() == 'butter'"
          }
        }
      }
    }
  },
  "hub": {
    "p": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['k', 'x', 'y', 'ts'])",
        "k": {
          ".validate": "newData.val() == 'fork' || newData.val() == 'knife' || newData.val() == 'butter'"
        },
        "n": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "d": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "a": {
          ".validate": "newData.isString() && newData.val().length <= 4"
        },
        "x": {
          ".validate": "newData.isNumber()"
        },
        "y": {
          ".validate": "newData.isNumber()"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "l": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "inv": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null",
        ".validate": "newData.child('code').isString() && newData.child('code').val().matches(/^[A-Z]{4}$/) && newData.child('ch').isString() && newData.child('ch').val().matches(/^[dt][1-3]$/) && newData.child('k').isString() && newData.child('from').val() == auth.uid"
      }
    },
    "lift": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".validate": "newData.child('from').isNumber() && newData.child('from').val() >= 0 && newData.child('from').val() <= 2 && newData.child('to').isNumber() && newData.child('to').val() >= 0 && newData.child('to').val() <= 2 && newData.child('t0').isNumber() && newData.child('dur').isNumber() && newData.child('dur').val() < 10"
    }
  }
}